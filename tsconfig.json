{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "noEmitOnError": true,
    "rootDir": "extensions",
    "outDir": "build/pi",
    "sourceMap": true,
    "types": ["node"]
  },
  "include": ["extensions/**/*.ts"]
}
