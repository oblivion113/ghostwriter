#!/usr/bin/env bash
set -euo pipefail

source_path="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)/bridges/pi/index.ts"
extension_dir="${PI_AGENT_DIR:-$HOME/.pi/agent}/extensions"
target_path="$extension_dir/ghostwriter.ts"

mkdir -p "$extension_dir"

if [[ -e "$target_path" && ! -L "$target_path" ]]; then
  printf 'Refusing to replace existing file: %s\n' "$target_path" >&2
  exit 1
fi

ln -sfn "$source_path" "$target_path"
printf 'Installed Pi bridge: %s -> %s\n' "$target_path" "$source_path"
printf 'Restart Pi or run /reload inside Pi.\n'
