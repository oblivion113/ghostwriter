Screen {
    background: #0d1017;
    color: #d8dee9;
}

Header {
    background: #161b26;
    color: #e5c07b;
}

#workspace {
    height: 1fr;
    padding: 1;
}

#editor-pane {
    width: 2fr;
    min-width: 48;
    margin-right: 1;
}

#side-pane {
    width: 1fr;
    min-width: 32;
    border-left: solid #30384a;
    padding-left: 1;
}

.section-title {
    color: #7aa2f7;
    text-style: bold;
    height: 1;
    margin-bottom: 1;
}

#prompt-editor {
    height: 1fr;
    border: round #46516a;
    background: #111621;
    padding: 0 1;
}

#prompt-editor:focus {
    border: round #7aa2f7;
}

#path-row {
    height: 3;
    margin-top: 1;
}

#attachment-path {
    width: 1fr;
    margin-right: 1;
}

#path-row Button {
    width: 12;
    margin-left: 1;
}

#actions {
    height: 3;
    margin-top: 1;
}

#actions Button {
    margin-right: 1;
}

#target {
    width: 1fr;
    margin-bottom: 1;
}

#refresh-targets,
#remove-attachment {
    width: 1fr;
    margin-bottom: 1;
}

#attachments {
    height: 12;
    border: round #30384a;
    margin-bottom: 1;
}

#preview-message {
    height: 1fr;
    content-align: center middle;
    color: #6f7787;
    border: round #30384a;
}

#image-preview {
    height: 1fr;
    width: 1fr;
    border: round #30384a;
}

#status {
    height: 1;
    background: #161b26;
    color: #9aa5ce;
    padding: 0 1;
}

Footer {
    background: #161b26;
}

Button.-success {
    background: #3a7a5e;
}

Screen.narrow #workspace {
    layout: vertical;
}

Screen.narrow #editor-pane,
Screen.narrow #side-pane {
    width: 1fr;
    min-width: 0;
}

Screen.narrow #editor-pane {
    height: 2fr;
    margin-right: 0;
    margin-bottom: 1;
}

Screen.narrow #side-pane {
    height: 1fr;
    border-left: none;
    border-top: solid #30384a;
    padding-left: 0;
    padding-top: 1;
}

Screen.narrow #preview-message,
Screen.narrow #image-preview {
    display: none;
}
