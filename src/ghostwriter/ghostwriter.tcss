Screen {
    background: #101318;
    color: #d7dbe2;
}

#top-bar {
    dock: top;
    width: 100%;
    height: 1;
    background: #171b21;
    color: #d7dbe2;
}

#settings-menu {
    width: 12;
    min-width: 0;
    height: 1;
    padding: 0 1;
    border: none;
    background: transparent;
    color: #d7dbe2;
    text-style: bold;
}

#settings-menu:hover,
#settings-menu:focus {
    background: $primary;
    color: $button-color-foreground;
}

#workspace {
    height: 1fr;
    padding: 1;
}

#editor-pane {
    width: 3fr;
    min-width: 56;
}

#prompt-region {
    height: 1fr;
    min-height: 8;
}

#width-handle,
#height-handle {
    color: #303640;
    pointer: pointer;
}

#width-handle {
    width: 1;
    height: 1fr;
}

#height-handle {
    width: 1fr;
    height: 1;
}

#width-handle:hover,
#height-handle:hover {
    color: #8d97a6;
}

#side-pane {
    width: 1fr;
    min-width: 30;
    height: 1fr;
    padding-left: 1;
}

.section-title {
    color: $primary;
    text-style: bold;
    height: 1;
}

#prompt-editor {
    height: 1fr;
    border: round #343b46;
    background: #14181e;
    color: #ffffff;
    overflow-x: hidden;
    overflow-y: auto;
    padding: 0 1;
}

#prompt-editor:focus {
    border: round #8d97a6;
}

PromptTextArea .prompt-attachment {
    color: $primary;
    text-style: bold;
}

PromptTextArea .prompt-skill {
    color: $success;
    text-style: bold;
}

#prompt-completions {
    height: 8;
    margin-top: 1;
    border: round #8d97a6;
    background: #14181e;
}

#actions {
    height: 1;
    margin-top: 1;
}

.tool-button {
    width: auto;
    min-width: 7;
    height: 1;
    line-pad: 1;
    margin-right: 1;
    border: none;
    background: $primary;
    color: $button-color-foreground;
    text-style: none;
}

.tool-button:hover,
.tool-button:focus {
    background: $primary-lighten-1;
    color: $button-color-foreground;
    text-style: bold;
}

.primary-action {
    background: $primary-darken-1;
    color: $button-color-foreground;
    text-style: bold;
}

.icon-button {
    min-width: 3;
    width: 3;
    margin-right: 0;
}

#target-row {
    height: 3;
    margin-bottom: 1;
    align-vertical: top;
}

#target {
    width: 1fr;
    height: 3;
    margin-right: 1;
    border: round #2d333d;
    background: #14181e;
}

#target SelectCurrent {
    background: transparent;
}

#remove-attachment {
    margin-bottom: 1;
}

#attachments {
    height: 9;
    border: round #2d333d;
    background: transparent;
}

#attachments:focus {
    background-tint: 0%;
}

#preview-path {
    height: auto;
    max-height: 3;
    margin-bottom: 1;
    color: #737c89;
}

#preview-message,
#text-preview,
#image-preview {
    height: 1fr;
    min-height: 12;
    width: 1fr;
    border: round #2d333d;
}

#preview-message {
    content-align: center middle;
    color: #737c89;
}

#text-preview {
    background: #14181e;
}

#status {
    height: 1;
    background: #171b21;
    color: #9199a6;
    padding: 0 1;
}

Footer {
    background: #171b21;
}

RewriteConfigScreen,
RewriteReviewScreen {
    align: center middle;
    background: #05070aaa;
}

#rewrite-config-dialog,
#rewrite-review-dialog {
    width: 88;
    max-width: 92%;
    background: #14181e;
    border: round #8d97a6;
    padding: 1 2;
}

#rewrite-config-dialog {
    height: auto;
    max-height: 95%;
}

#rewrite-review-dialog {
    height: 88%;
}

.dialog-title {
    height: 1;
    color: #d7dbe2;
    text-style: bold;
    margin-bottom: 1;
}

.dialog-help {
    height: auto;
    color: #9199a6;
    margin-bottom: 1;
}

.checkbox-row {
    height: 1;
    margin-bottom: 1;
}

.dialog-actions {
    height: 1;
    margin: 1 0;
}

.checkbox-row Checkbox {
    width: auto;
    height: 1;
    margin-right: 2;
}

.dialog-actions Button {
    margin-right: 1;
}

#rewrite-config-dialog Input,
#rewrite-config-dialog Select {
    margin-bottom: 0;
}

#rewrite-result {
    height: 1fr;
    border: round #343b46;
    margin: 1 0;
}

#rewrite-feedback {
    margin-top: 1;
}

Screen.stacked #workspace {
    layout: vertical;
}

Screen.stacked #editor-pane,
Screen.stacked #side-pane {
    width: 1fr;
    min-width: 0;
}

Screen.stacked #width-handle {
    width: 1fr;
    height: 1;
}

Screen.stacked #side-pane {
    padding-left: 0;
    padding-top: 1;
}
